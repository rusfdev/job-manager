{
  "name": "@repo/common",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./domain": {
      "types": "./src/domain/index.ts",
      "default": "./dist/domain/index.js"
    },
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "default": "./dist/contracts/index.js"
    },
    "./assert": {
      "types": "./src/assert/index.ts",
      "default": "./dist/assert/index.js"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "default": "./dist/errors/index.js"
    },
    "./result": {
      "types": "./src/result/index.ts",
      "default": "./dist/result/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix ."
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "catalog:"
  }
}
