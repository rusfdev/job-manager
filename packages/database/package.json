{
  "name": "@repo/database",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/drizzle": "catalog:",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/drizzle": "catalog:",
    "drizzle-orm": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  }
}
