{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": {
    "newlinesBetween": false,
    "customGroups": [
      {
        "groupName": "repo-shared",
        "elementNamePattern": ["@repo/shared", "@repo/shared/**"]
      },
      {
        "groupName": "repo-database",
        "elementNamePattern": ["@repo/database", "@repo/database/**"]
      },
      {
        "groupName": "repo-nestjs",
        "elementNamePattern": ["@repo/nestjs-*", "@repo/nestjs-*/**"]
      }
    ],
    "groups": [
      "builtin",
      "external",
      "repo-shared",
      "repo-database",
      "repo-nestjs",
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  }
}
