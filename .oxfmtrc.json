{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": {
    "newlinesBetween": false,
    "customGroups": [
      {
        "groupName": "repo-common",
        "elementNamePattern": ["@repo/common", "@repo/common/**"]
      },
      {
        "groupName": "repo-database",
        "elementNamePattern": ["@repo/database", "@repo/database/**"]
      },
      {
        "groupName": "repo-id-generator",
        "elementNamePattern": ["@repo/id-generator"]
      },
      {
        "groupName": "repo-logger",
        "elementNamePattern": ["@repo/logger"]
      },
      {
        "groupName": "repo-auth-common",
        "elementNamePattern": ["@repo/auth-common", "@repo/auth-common/**"]
      },
      {
        "groupName": "repo-auth-core",
        "elementNamePattern": ["@repo/auth-core"]
      },
      {
        "groupName": "repo-auth-api",
        "elementNamePattern": ["@repo/auth-api"]
      },
      {
        "groupName": "repo-vacancy-common",
        "elementNamePattern": ["@repo/vacancy-common", "@repo/vacancy-common/**"]
      },
      {
        "groupName": "repo-vacancy-core",
        "elementNamePattern": ["@repo/vacancy-core", "@repo/vacancy-core/**"]
      },
      {
        "groupName": "repo-vacancy-api",
        "elementNamePattern": ["@repo/vacancy-api"]
      }
    ],
    "groups": [
      "builtin",
      "external",
      "repo-common",
      "repo-database",
      "repo-id-generator",
      "repo-logger",
      "repo-auth-common",
      "repo-auth-core",
      "repo-auth-api",
      "repo-vacancy-common",
      "repo-vacancy-core",
      "repo-vacancy-api",
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  }
}
