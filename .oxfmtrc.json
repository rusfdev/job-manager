{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["packages/shared/platform/database/drizzle/**"],
  "sortImports": {
    "newlinesBetween": false,
    "customGroups": [
      // @nestjs/common, then @nestjs/core, then other @nestjs/* A-Z
      {
        "groupName": "nestjs-common",
        "elementNamePattern": ["@nestjs/common", "@nestjs/common/**"]
      },
      {
        "groupName": "nestjs-core",
        "elementNamePattern": ["@nestjs/core", "@nestjs/core/**"]
      },
      {
        "groupName": "nestjs",
        "elementNamePattern": ["@nestjs/*", "@nestjs/*/**"]
      },
      // @repo/common
      {
        "groupName": "repo-common",
        "elementNamePattern": ["@repo/common", "@repo/common/**"]
      },
      // @repo platform packages: database, id-generator, logger
      {
        "groupName": "repo-database",
        "elementNamePattern": ["@repo/database", "@repo/database/**"]
      },
      {
        "groupName": "repo-id-generator",
        "elementNamePattern": ["@repo/id-generator"]
      },
      {
        "groupName": "repo-logger",
        "elementNamePattern": ["@repo/logger"]
      },
      // @repo auth module: common, module
      {
        "groupName": "repo-auth-common",
        "elementNamePattern": ["@repo/auth-common", "@repo/auth-common/**"]
      },
      {
        "groupName": "repo-auth",
        "elementNamePattern": ["@repo/auth", "@repo/auth/**"]
      },
      // @repo vacancy module: common, module
      {
        "groupName": "repo-vacancy-common",
        "elementNamePattern": ["@repo/vacancy-common", "@repo/vacancy-common/**"]
      },
      {
        "groupName": "repo-vacancy",
        "elementNamePattern": ["@repo/vacancy", "@repo/vacancy/**"]
      }
    ],
    "groups": [
      // Built-in modules: node:fs, node:path, ...
      "builtin",
      // @nestjs/common, then @nestjs/core, then other @nestjs/* A-Z
      "nestjs-common",
      "nestjs-core",
      "nestjs",
      // Other third-party packages
      "external",
      // @repo/common
      "repo-common",
      // @repo platform packages: database, id-generator, logger
      "repo-database",
      "repo-id-generator",
      "repo-logger",
      // @repo auth module: common, module
      "repo-auth-common",
      "repo-auth",
      // @repo vacancy module: common, module
      "repo-vacancy-common",
      "repo-vacancy",
      // Relative imports: ../, ./
      ["parent", "sibling", "index"],
      // Style imports: .css, .scss, ...
      "style",
      // Imports not matched by any group above
      "unknown"
    ]
  }
}
