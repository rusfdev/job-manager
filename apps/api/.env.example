# HTTP port the API listens on.
PORT=3000

# Postgres connection string;`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15432/job_manager

# Comma-separated log levels: verbose, debug, log, warn, error, fatal.
LOG_LEVELS=verbose,debug,log,warn,error,fatal

# Default rate limit: at most THROTTLE_LIMIT requests per client within THROTTLE_TTL milliseconds.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
