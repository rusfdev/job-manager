{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "removeComments": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["vitest/globals", "node"]
  }
}
